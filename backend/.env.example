# Meta Model API key from the Meta developer portal.
MODEL_API_KEY=

# Optional compatibility name for existing local setups.
META_API_KEY=

META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_API_TIMEOUT_SECONDS=60

# Browser origins allowed to call the local API. In production, replace these
# with the exact scheme/host/port used by the deployed frontend.
TESTFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

TESTFORGE_DOCKER_TIMEOUT_SECONDS=60
TESTFORGE_DOCKER_MEMORY_LIMIT=512m
TESTFORGE_DOCKER_NANO_CPUS=1000000000
TESTFORGE_DOCKER_PIDS_LIMIT=64

# UTF-8 byte limits applied before Meta requests and Docker execution.
TESTFORGE_MAX_SOURCE_BYTES=262144
TESTFORGE_MAX_TEST_BYTES=524288
